```elixir
input_puzzleInput = Kino.Input.textarea("Puzzle Input", monospace: true)
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
input_source_select =
  Kino.Input.select("Source", [{:example, "example"}, {:puzzle_input, "puzzle input"}])
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
data = fn ->
  (Kino.Input.read(input_source_select) == :example &&
     Kino.Input.read(input_example)) ||
    Kino.Input.read(input_puzzleInput)
end
```

## Solution

```elixir
defmodule Day11 do
  # No need to actually build a hex grid for part 1 - just calculate the location
  # the path would take you to.
  # 
  # But this grid is skewed at a 60 degree angle, such that
  # nw/center/se are on the same X line one digit apart..
  # -1\ n  /
  # nw +--+ ne
  #   /    \
  # -+   0  +-
  #   \    / 1
  # sw +--+ se
  #   / s  \
  #
    
  @grid_width 50_000
  @center_x 0 # div(@grid_width, 2)
  @center_y 0 # div(@grid_width, 2)
  
  def solve1(text, expected \\ nil) do
    accumulator = %{x: @center_x, y: @center_y}
    |> IO.inspect(label: "start")
    
    result = text
      |> String.split(",")
      |> Enum.reduce(accumulator, fn dir, acc ->
        case dir do
          "n" -> %{x: acc.x, y: acc.y - @grid_width} 
          "ne" -> %{x: acc.x + 1, y: acc.y - @grid_width} 
          "nw" -> %{x: acc.x - 1, y: acc.y} 
          "se" -> %{x: acc.x + 1, y: acc.y} 
          "sw" -> %{x: acc.x - 1, y: acc.y + @grid_width} 
          "s" -> %{x: acc.x, y: acc.y + @grid_width} 
        end
        # |> IO.inspect(label: dir)
      end)
      |> IO.inspect(label: "result")

    {_, result} = get_and_update_in(result, [:y], fn y -> {y, div(y, @grid_width) - 1} end)
    {_, result} = get_and_update_in(result, [:x], fn x -> {x, abs(x - @center_x)} end)
    
    IO.inspect([result, result.x + result.y, expected, text], label: "normalized Y result")
  end

  # def solve2(text) do
  # end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day11.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: 3)")
# 1261 is too high, as is 1260
# 1223 "that isn't right - go see reddit"

Day11.solve1("ne,ne,ne", 3)
Day11.solve1("ne,ne,sw,sw", 0)
Day11.solve1("ne,ne,s,s", 2)
Day11.solve1("se,sw,se,sw,sw", 3)

# data.()
# |> Day11.solve2()
# |> IO.inspect(label: "\n*** Part 2 solution (example: )")
# 

```
