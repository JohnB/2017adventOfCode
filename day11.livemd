```elixir
data = fn ->
  (Kino.Input.read(input_source_select) == :example &&
     Kino.Input.read(input_example)) ||
    Kino.Input.read(input_puzzleInput)
end
```

## Solution

```elixir
defmodule Day11 do
  # No need to actually build a hex grid for part 1 - just calculate the location
  # the path would take you to.
  # 
  # But this grid is skewed at a 60 degree angle, such that
  # nw/center/se are on the same X line one digit apart..
  # -1\ n  /
  # nw +--+ ne
  #   /    \
  # -+   0  +-
  #   \    / 1
  # sw +--+ se
  #   / s  \
  #
    
  # @grid_width 50_000
  # @center_x 0 # div(@grid_width, 2)
  # @center_y 0 # div(@grid_width, 2)

  # Reduce "se,sw" to "s"
  def funnel(map, wrong1, wrong2, right) do
    num_incorrect = min(map[wrong1], map[wrong2])
    map
    |> Map.update!(wrong1, &(&1 - num_incorrect))
    |> Map.update!(right, &(&1 + num_incorrect))
    |> Map.update!(wrong2, &(&1 - num_incorrect))
  end

  # Reduce "se,n" to "ne"
  def normalize(map, wrong, right, direct) do
    num_incorrect = min(map[wrong], map[direct])
    map
    |> Map.update!(wrong, &(&1 - num_incorrect))
    |> Map.update!(right, &(&1 + num_incorrect))
    |> Map.update!(direct, &(&1 - num_incorrect))
  end

  # Reduce one of the directions to zero
  def normalize(map, a, b) do
    if map[a] > map[b] do
      map
      |> Map.put(a, map[a] - map[b])
      |> Map.put(b, 0)
    else
      map
      |> Map.put(b, map[b] - map[a])
      |> Map.put(a, 0)
    end
    |> IO.inspect(label: "normalized #{a} and #{b}")
  end
  
  def solve1(text, expected \\ nil) do
    moves = String.split(text, ",", trim: true)
    cardinals = ["se", "n", "sw", "ne", "nw", "s"]
    histogram = Enum.reduce(cardinals, %{}, fn dir, acc ->
      count = moves
        |> Enum.filter(fn x -> x == dir end)
        |> Enum.count()

      Map.put(acc, dir, count)
    end)
    |> AOC.inspect(label: "\ninitial histogram")

    updated =  normalize(histogram, "nw", "se")
      |> normalize("ne", "sw")
      |> normalize("n", "s")
      |> funnel("nw", "ne", "n")
      |> funnel("sw", "se", "s")
      |> normalize("se", "ne", "n")
      |> normalize("sw", "nw", "n")
      |> normalize("ne", "se", "s")
      |> normalize("nw", "sw", "s")
      |> normalize("ne", "s", "se")
      |> normalize("nw", "s", "sw")
      |> normalize("se", "n", "ne")
      |> normalize("sw", "n", "nw")

    result = Map.values(updated) |> Enum.sum()
    IO.inspect([expected, result, text, updated], label: "expected result")
  end

  # def solve2(text) do
  # end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day11.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: 3)")
# 824

# Day11.solve1("ne,ne,ne", 3)
# Day11.solve1("ne,ne,sw,sw", 0)
# Day11.solve1("ne,ne,s,s", 2)
# Day11.solve1("se,sw,se,sw,sw", 3)

# data.()
# |> Day11.solve2()
# |> IO.inspect(label: "\n*** Part 2 solution (example: )")
# 

```
