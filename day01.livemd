## Installation and Data

```elixir
input_example = Kino.Input.textarea("Example Data", monospace: true)
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
input_puzzleInput = Kino.Input.textarea("Puzzle Input", monospace: true)
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
input_source_select =
  Kino.Input.select("Source", [{:example, "example"}, {:puzzle_input, "puzzle input"}])
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
data = fn ->
  (Kino.Input.read(input_source_select) == :example &&
     Kino.Input.read(input_example)) ||
    Kino.Input.read(input_puzzleInput)
end
```

## Solution

```elixir
defmodule Day01 do
  def solve1(text) do
    (text <> String.first(text))
    |> String.split("", trim: true) 
    |> Enum.map(&String.to_integer/1) 
    |> Enum.chunk_every(2, 1, :discard) 
    |> Enum.reduce(0, fn [a, b], acc -> acc + ((a == b) && a || 0) end)
  end

  def solve2(s) do
    slen = String.length(s) 
    
    s 
    |> String.split("", trim: true) 
    |> Enum.chunk_every(div(slen, 2)) 
    |> Enum.zip_with(fn [a, b] -> (a == b && 2 * String.to_integer(a) || 0) end) 
    |> Enum.sum()
  end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day01.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: )")
#

data.()
|> Day01.solve2()
|> IO.inspect(label: "\n*** Part 2 solution (example: )")
# 

```
