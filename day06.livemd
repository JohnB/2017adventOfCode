## Solution

```elixir
defmodule Day06 do
  def banks_to_string(banks) do
    (0..(Enum.count(banks) - 1))
    |> Enum.map(fn index -> banks[index] end)
    |> Enum.join(",")
  end

  def choose_first_biggest(banks) do
    max = Map.values(banks) |> Enum.max()
    location = (0..Enum.count(banks))
      |> Enum.find(fn index -> banks[index] == max end)

    {max, location}
  end

  def indexes_after(current, bank_count) do
    (1..bank_count)
    |> Enum.map(fn index -> rem(index + current, bank_count) end)
  end

  def redistribute(banks, bank, index) do
    bank_count = Enum.count(banks)
    common = div(bank, bank_count)
    accumulator = %{banks: Map.put(banks, index, 0), dribble: rem(bank, bank_count)}
    
    indexes_after(index, bank_count)
    |> Enum.reduce(accumulator, fn ind, acc ->
      # IO.inspect(acc, label: "???")
      additional = (acc.dribble > 0) && (common + 1) || common
      {_, bank2} = get_and_update_in(acc.banks, [ind], fn orig -> {orig, orig + additional} end)
      
      %{ banks: bank2, dribble: acc.dribble - 1}
    end)
    |> Map.get(:banks)
    # |> IO.inspect(label: "socialism")
  end
  
  def solve1(text) do
    banks = text
      |> AOC.delimited_by_spaces()
      |> Enum.map(&String.to_integer/1)
      |> IO.inspect()
      |> Enum.with_index()
      |> IO.inspect()
      |> Enum.reduce(%{}, fn {value, index}, acc -> Map.put(acc, index, value) end)
      |> IO.inspect()

    infinite_stream = Stream.iterate(1, &(&1 + 1))
    accumulator = %{banks: banks, history: %{banks_to_string(banks) => 0}}
    Enum.reduce_while(infinite_stream, accumulator, fn cycle, acc ->
      IO.inspect(acc, label: "cycle #{cycle}")
      {bank, index} = choose_first_biggest(acc.banks)
      banks = redistribute(acc.banks, bank, index)
      banksy = banks_to_string(banks)
      # AOC.inspect([bank, index, banksy, banks])
      if !is_nil(acc.history[banksy]) do
        {:halt, {cycle, acc.history[banksy], cycle - acc.history[banksy]}}
      else
        {:cont, %{banks: banks, history: Map.put(acc.history, banksy, cycle)}}
      end
    end)
  end

  # def solve2(text) do
  # end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day06.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: 5)")
#

# data.()
# |> Day06.solve2()
# |> IO.inspect(label: "\n*** Part 2 solution (example: )")
# {14029, 11264, 2765}

```
